{
  "name": "vay-tutor-host",
  "private": true,
  "version": "0.2.0",
  "description": "Full installation. MongoDB, the API, and the institute UI on this computer.",
  "author": "Vay Tutor",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/supervisor.test.js src/tabs.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "selfsigned": "2.4.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vaytutor.host",
    "productName": "Vay Tutor",
    "directories": {
      "output": "../release"
    },
    "files": [
      "src/main.js",
      "src/supervisor.js",
      "src/tabs.js",
      "src/preload.js",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/mongo", "to": "mongo" },
      { "from": "resources/python", "to": "python" },
      { "from": "resources/backend", "to": "backend" },
      { "from": "resources/frontend", "to": "frontend" }
    ],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "../build/icon.ico",
      "extraResources": [
        { "from": "resources/redist", "to": "redist" },
        { "from": "build/start-supervisor.cmd", "to": "start-supervisor.cmd" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vay Tutor",
      "deleteAppDataOnUninstall": false,
      "artifactName": "VayTutor-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "../build/icon.icns",
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "artifactName": "VayTutor-${version}.${ext}"
    }
  }
}
